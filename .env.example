# Яндекс OAuth client_id из https://oauth.yandex.ru/
# Redirect URI: https://fiscalagent.github.io/AppTochite/oauth/yandex/callback
VITE_YANDEX_CLIENT_ID=your_client_id_here

# CORS-прокси для скачивания бэкапа из облака (Cloudflare Worker, см. cloudflare-worker/).
# Без него облачное «Объединить»/«Скачать файл» ведут к восстановлению из файла.
VITE_CLOUD_PROXY_URL=https://cloud-proxy.example.workers.dev
